
//  MODULE PORT     BOARD COMPONENT
    core_clk         =   clk_1hz;
    core_err         =   sw7;
    core_rst         =   sw6;
    core_load        =   sw5;
    core_done        =   sw4;

    core_din[0]   = sw0;
    core_din[1]   = sw1;
    core_din[2]   = sw2;
    core_din[3]   = sw3;

// Shift-load-system:

    core_led_o[0] = led1;
    core_led_o[1] = led2;
    core_led_o[2] = led3; 
    core_led_o[3] = led4;
    core_led_o[4] = led5;
    core_led_o[5] = led6;

// Clock-led:
    core_clk_o[0] = led0;
    core_clk_o[1] = led7;

